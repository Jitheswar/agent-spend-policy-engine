# Copy to .env and edit. Everything here has a working default, so an empty
# .env (or none at all) runs against Algorand testnet exactly as shipped.
#
#   cp .env.example .env
#
# Real environment variables override this file, so `NETWORK=mainnet ./start.sh`
# beats whatever is written below without editing anything.
#
# Resolved values, before anything spends:  python3 -m common.config


# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# testnet | mainnet. This one setting derives the algod node, the indexer,
# the USDC asset id, the CAIP-2 chain id and the explorer links together, so
# they cannot end up disagreeing with each other. Localnet isn't supported:
# settlement goes through a public x402 facilitator, which can't reach a
# chain running on your machine.
NETWORK=testnet

# Mainnet moves real funds. Every /admin route is an authority over money,
# so NETWORK=mainnet refuses to start without this set alongside it.
# ALLOW_MAINNET=true


# ---------------------------------------------------------------------------
# Admin plane
# ---------------------------------------------------------------------------

# The bearer token every /admin route requires -- freeze, unfreeze, onboard,
# approve a held spend, edit a cap. Leave it unset and one is generated on
# first run and kept in data/admin_token.txt; start.sh hands that to the
# dashboard automatically, so the demo needs no setup either way.
#
# Setting it EMPTY (ADMIN_TOKEN=) disables authentication entirely. That is
# a real option for a throwaway testnet box and is refused outright on
# mainnet: unauthenticated + real funds means whoever reaches the port owns
# the kill switch.
# ADMIN_TOKEN=
# ADMIN_TOKEN_PATH=./data/admin_token.txt

# The demo-only routes: POST /admin/sign (signs a /spend request as ANY
# agent -- a signing oracle, and the reason the identity guarantee is
# phrased the way it is) and POST /admin/demo/* (doctors and restores audit
# records for the tamper demo). Defaults to on for testnet, off for mainnet.
# ALLOW_DEMO_ENDPOINTS=true


# ---------------------------------------------------------------------------
# Request limits
# ---------------------------------------------------------------------------

# Hard ceilings on the call arguments a /spend request may carry. NOT the
# governance control -- policy.json's per-action max_length is that. These
# exist because /spend is open to unauthenticated callers by design and
# every attempt, including a denial, is written into a ledger with no
# delete path.
# MAX_PARAM_KEYS=16
# MAX_PARAM_KEY_LENGTH=64
# MAX_PARAM_VALUE_LENGTH=512

# The window the per-agent rate limit is measured over.
# VELOCITY_WINDOW_SECONDS=60

# Override individual endpoints only if you have a reason -- a private algod,
# a paid indexer tier, your own facilitator. Left unset, each follows NETWORK.
# ALGOD_URL=
# ALGOD_TOKEN=
# INDEXER_URL=
# USDC_ASA_ID=
# EXPLORER_TX_URL=https://lora.algokit.io/testnet/transaction/{}
# FACILITATOR_URL=https://facilitator.goplausible.xyz

# The address that receives every payment. Defaults to the `server` account
# in data/accounts.json. Point it at a wallet you already control if you'd
# rather not have the payee be a key this repo generated.
# AVM_ADDRESS=


# ---------------------------------------------------------------------------
# Upstream APIs
# ---------------------------------------------------------------------------

# SEC's fair-access policy asks callers to identify themselves and throttles
# the ones that don't. Set this to something that reaches you before pointing
# any real traffic at EDGAR. Open-Meteo needs nothing.
# SEC_USER_AGENT=your-project/1.0 (you@example.com)

# Per-upstream timeout. Stays well under OUTBOUND_TIMEOUT_SECONDS: that
# budget covers this call AND the facilitator round trip, and an upstream
# allowed to eat all of it surfaces as a payment failure instead of a
# vendor one.
# UPSTREAM_TIMEOUT_SECONDS=10


# ---------------------------------------------------------------------------
# Services
# ---------------------------------------------------------------------------

# RESOURCE_SERVER_PORT=4021
# POLICY_ENGINE_PORT=4022
# DASHBOARD_PORT=4023
# BIND_HOST=127.0.0.1

# Where the services find each other. Both follow the ports above; set them
# only if a service is running somewhere else entirely.
# RESOURCE_SERVER_URL=http://127.0.0.1:4021
# POLICY_ENGINE_URL=http://127.0.0.1:4022

# The browser origins allowed to call the policy engine. Follows
# DASHBOARD_PORT automatically; set it only for a non-local dashboard.
# DASHBOARD_ORIGINS=http://127.0.0.1:4023,http://localhost:4023

# How long the engine waits on the resource server. Generous on purpose --
# it covers the upstream fetch plus facilitator plus chain, and the public
# testnet endpoints are genuinely slow sometimes. Too low manufactures false
# denials out of slow-but-working payments.
# OUTBOUND_TIMEOUT_SECONDS=60


# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# Anchor the audit chain head on-chain once this many events have piled up.
# Lower = smaller tamper window, more transaction fees.
# AUTO_ANCHOR_THRESHOLD=8

# Skips every outbound Algorand write. Set by tests/conftest.py so a unit
# run never submits a transaction.
# ASPE_DISABLE_ANCHOR=1

# What each newly onboarded agent is funded with, out of the treasury.
# PROVISION_ALGO=0.5
# PROVISION_USDC=0.5

# Which account in accounts.json is the treasury: it receives every payment,
# pays anchoring fees, and funds newly onboarded agents.
# ANCHOR_ACCOUNT=server


# ---------------------------------------------------------------------------
# scripts/phase1_client.py
# ---------------------------------------------------------------------------

# Which paid call the raw x402 proof script makes. ACTION has to match
# ENDPOINT_PATH -- the policy-auth token it mints commits to the action and
# to the arguments below, and the resource server checks both.
# ENDPOINT_PATH=/weather
# ACTION=weather
# AGENT_NAME=agent_weather
# CITY=San Francisco
# COMPANY=Apple Inc.


# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

# DATA_DIR=./data
# ACCOUNTS_PATH=./data/accounts.json
# DB_PATH=./data/policy_engine.db
# POLICY_PATH=./policy_engine/policy.json
