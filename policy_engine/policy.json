{
  "actions": {
    "weather": {
      "resource_path": "/weather",
      "price_usd": 0.01,
      "description": "Live current conditions (Open-Meteo)",
      "params": {
        "city": {
          "required": true,
          "max_length": 64,
          "default": "San Francisco"
        }
      }
    },
    "enrich": {
      "resource_path": "/enrich",
      "price_usd": 0.05,
      "description": "Public company filer profile (SEC EDGAR)",
      "params": {
        "company": {
          "required": true,
          "max_length": 64,
          "default": "Apple Inc."
        }
      }
    }
  },
  "agents": {
    "agent_weather": {
      "display_name": "Weather Bot",
      "allowed_actions": [
        "weather"
      ],
      "per_request_limit_usd": 0.02,
      "daily_cap_usd": 1.0,
      "frozen": false,
      "max_requests_per_minute": 15,
      "require_approval_above_usd": 0.01
    },
    "agent_enrichment": {
      "display_name": "Enrichment Bot",
      "allowed_actions": [
        "enrich"
      ],
      "per_request_limit_usd": 0.1,
      "daily_cap_usd": 2.0,
      "frozen": false,
      "max_requests_per_minute": 15,
      "require_approval_above_usd": 0.05
    },
    "agent_rogue": {
      "display_name": "Rogue Bot (tightly capped, on purpose)",
      "allowed_actions": [
        "weather"
      ],
      "per_request_limit_usd": 0.01,
      "daily_cap_usd": 0.02,
      "frozen": false,
      "max_requests_per_minute": 10,
      "require_approval_above_usd": null
    }
  }
}
